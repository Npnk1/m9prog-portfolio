# Kopieer dit bestand naar .env en kies eigen wachtwoorden.
# .env staat in .gitignore en komt dus nooit in Git.
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=kies-een-wachtwoord
DB_ROOT_PASSWORD=kies-een-root-wachtwoord

WP_URL=http://localhost:8080
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=kies-een-admin-wachtwoord
WP_ADMIN_EMAIL=admin@example.com
